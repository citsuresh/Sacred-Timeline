    <!-- Tithi Descriptions -->
    <string name="tithi_desc_generic">திதி என்பது சந்திர நாள். ஒவ்வொரு திதிக்கும் தினசரி நடவடிக்கைகளில் பாதிப்பை ஏற்படுத்தும் குறிப்பிட்ட ஆற்றல் உள்ளது.</string>
    <string name="tithi_desc_1">பிரதமை: மதச் சடங்குகளுக்கும் புதிய முயற்சிகளைத் தொடங்குவதற்கும் நல்லது.</string>
    <string name="tithi_desc_2">துவிதியை: அஸ்திவாரம் அமைப்பதற்கும், திருமணங்களுக்கும், நீண்ட கால முதலீடுகளுக்கும் உகந்தது.</string>
    <string name="tithi_desc_3">திருதியை: அனைத்து நற்பண்புகளுக்கும் நன்மையான தொடக்கங்களுக்கும் மிகவும் மங்களகரமானது.</string>
    <string name="tithi_desc_4">சதுர்த்தி: விநாயகப் பெருமானுடன் தொடர்புடையது. தடைகளை நீக்க நல்லது, ஆனால் பொதுவாக திருமணங்களைத் தவிர்ப்பது நல்லது.</string>
    <string name="tithi_desc_5">பஞ்சமி: அனைத்து மத நடவடிக்கைகளுக்கும் நிர்வாகப் பணிகளுக்கும் சாதகமானது.</string>
    <string name="tithi_desc_6">சஷ்டி: முருகப் பெருமானுடன் தொடர்புடையது. கட்டுமானப் பணிகளுக்கும் துணிச்சலான செயல்களுக்கும் சாதகமானது.</string>
    <string name="tithi_desc_7">சப்தமி: பயணங்களைத் தொடங்குவதற்கும் மருத்துவ சிகிச்சைகளுக்கும் மங்களகரமானது.</string>
    <string name="tithi_desc_8">அஷ்டமி: பணிகளை முடிக்க ஏற்றது, ஆனால் முடிந்தவரை புதிய முயற்சிகளைத் தவிர்க்கவும்.</string>
    <string name="tithi_desc_9">நவமி: பொதுவாக மங்களகரமான தொடக்கங்களைத் தவிர்ப்பது நல்லது; எதிரிகளை வெல்வதற்கும் சட்ட விவகாரங்களுக்கும் நல்லது.</string>
    <string name="tithi_desc_10">தசமி: அனைத்து வகையான வேலைகளுக்கும், பயணங்களுக்கும், புதிய முயற்சிகளுக்கும் மிகவும் மங்களகரமானது.</string>
    <string name="tithi_desc_11">ஏகாதசி: விரதங்கள், ஆன்மீகப் பயிற்சிகள் மற்றும் மத அனுஷ்டானங்களுக்குச் சிறந்தது.</string>
    <string name="tithi_desc_12">துவாதசி: தானம் செய்வதற்கும் ஏகாதசியில் தொடங்கிய மதச் சடங்குகளை முடிப்பதற்கும் நல்லது.</string>
    <string name="tithi_desc_13">திரயோதசி: பிரதோஷத்துடன் தொடர்புடையது. நட்பு, கலை மற்றும் ஆன்மீக வளர்ச்சிக்கு நல்லது.</string>
    <string name="tithi_desc_14">சதுர்தசி: மங்களகரமான தொடக்கங்களைத் தவிர்க்கவும்; ஆன்மீகப் பயிற்சிகளுக்கும் பணிகளை முடிப்பதற்கும் ஏற்றது.</string>
    <string name="tithi_desc_15">பௌர்ணமி: அனைத்து நற்பண்புகளுக்கும், தியானத்திற்கும், சடங்குகளுக்கும் மிகவும் மங்களகரமானது.</string>
    <string name="tithi_desc_30">அமாவாசை: முன்னோர்களுக்கு (பித்ருக்கள்) அர்ப்பணிக்கப்பட்டது. தானம் மற்றும் ஆன்மீக சுயபரிசோதனைக்கு நல்லது; புதிய முயற்சிகளைத் தவிர்க்கவும்.</string>

    <!-- Nakshatra Descriptions -->
    <string name="star_desc_generic">இந்தக் காலத்தில் இருக்கும் நட்சத்திரம் மன மற்றும் உணர்ச்சி நிலையை பாதிக்கிறது. இந்த நட்சத்திரம் பாரம்பரியமாக நடவடிக்கைகளுக்கான பொருத்தத்தை தீர்மானிக்கப் பயன்படுகிறது.</string>
    <string name="star_desc_3">கிருத்திகை: நெருப்புடன் தொடர்புடையது. சுத்திகரிப்பு, கடின உழைப்பு மற்றும் தொழில்நுட்ப பணிகளுக்கு நல்லது.</string>
    <string name="star_desc_4">ரோகிணி: மிகவும் மங்களகரமானது. வளர்ச்சி, படைப்பாற்றல் மற்றும் அனைத்து நேர்மறையான தொடக்கங்களுக்கும் ஏற்றது.</string>
    <string name="star_desc_8">பூசம்: அனைத்து நற்பண்புகளுக்கும் ஊக்கமளிக்கும் நடவடிக்கைகளுக்கும் மிகவும் மங்களகரமான நட்சத்திரம்.</string>

    <!-- Event Descriptions -->
    <string name="event_desc_pradosham">சிவபெருமானுக்கு அர்ப்பணிக்கப்பட்ட ஒரு மங்களகரமான காலம். மன்னிப்பு மற்றும் ஆன்மீக விடுதலையைப் பெறுவதற்கு ஏற்றது.</string>
    <string name="event_desc_sivaratri">சிவபெருமானுக்கு மாதாந்திர அனுஷ்டானம். தியானம், விரதம் மற்றும் ஆன்மீக விழிப்புணர்வில் கவனம் செலுத்துங்கள்.</string>
    <string name="event_desc_aadi_kiruthigai">ஆடி கிருத்திகை: ஆடி மாதத்தில் வரும் கிருத்திகை நட்சத்திரத்தில் முருகப்பெருமானுக்கு அர்ப்பணிக்கப்பட்ட ஒரு முக்கிய திருவிழா. இது பக்தி மற்றும் முருகனின் அருளைப் பெறுவதற்கான சிறப்பு நாளாகும்.</string>
    <string name="event_desc_aadi_pooram">ஆடி பூரம்: மகாலட்சுமியின் அவதாரமான ஆண்டாள் நாச்சியார் பிறந்த நாளைக் கொண்டாடும் சிறப்பு நாள். இது தமிழகம் முழுவதும் உள்ள ஆலயங்களில் வெகு விமர்சையாகக் கொண்டாடப்படுகிறது.</string>
    <string name="event_desc_generic">இந்தக் காலத்தில் கடைபிடிக்கப்படும் ஒரு சிறப்பு மத அல்லது பாரம்பரிய நிகழ்வு.</string>
    <string name="event_desc_tamil_date">தமிழ் நாட்காட்டி என்பது தமிழ்நாட்டில் பாரம்பரியமாகப் பயன்படுத்தப்படும் ஒரு சூரிய நாட்காட்டியாகும். இது ராசிகளில் சூரியன் நுழைவதைப் பொறுத்து மாதங்களைக் குறிக்கிறது.</string>

    <string name="desc_month_generic">தமிழ் நாட்காட்டியில் உள்ள இந்த மாதம் தனித்துவமான ஆன்மீக மற்றும் பருவகால முக்கியத்துவத்தைக் கொண்டுள்ளது.</string>

    <!-- Muhurtham Descriptions -->
    <string name="muhurtham_desc_brahma">"பிரம்ம முஹூர்த்தம்." தியானம், யோகா மற்றும் கவனத்துடன் நாளைத் தொடங்குவதற்கு மிகவும் மங்களகரமானது.</string>
    <string name="muhurtham_desc_abhijit">அபிஜித் முஹூர்த்தம்: எந்தவொரு வேலைக்கும் அன்றைய நாளின் மிகவும் மங்களகரமான நேரம். வெற்றி கிடைக்க அதிக வாய்ப்புள்ளது.</string>
    <string name="muhurtham_desc_subha">முக்கியமான வாழ்க்கை நிகழ்வுகளுக்கான சரிபார்க்கப்பட்ட மங்களகரமான காலம்.</string>

