    <!-- Metadata: Energy Descriptions -->
    <string name="desc_thara_1">ஜென்ம தாரை: உங்கள் உடல் மற்றும் மனம் சார்ந்த நிலை. வழக்கமான பணிகளுக்கு ஏற்றது.</string>
    <string name="desc_thara_2">செல்வ தாரை: செல்வம் மற்றும் லாபம் தரும் காலம். புதிய முதலீடுகளுக்கு மிகச் சிறப்பு.</string>
    <string name="desc_thara_3">விபத்து தாரை: விபத்து மற்றும் ஆபத்து ஏற்பட வாய்ப்புள்ள காலம். பயணங்களைத் தவிர்க்கவும்.</string>
    <string name="desc_thara_4">சுக தாரை: சுகம் மற்றும் ஆரோக்கியம் தரும் காலம். குடும்ப விசேஷங்களுக்கு ஏற்றது.</string>
    <string name="desc_thara_5">பகை தாரை: காரியத் தடை மற்றும் எதிர்ப்புகள் வரலாம். நிதானம் தேவை.</string>
    <string name="desc_thara_6">சாதக தாரை: காரிய சித்தி மற்றும் வெற்றி தரும் காலம். புதிய முயற்சிகளைத் தொடங்கலாம்.</string>
    <string name="desc_thara_7">வதைய தாரை: மிகவும் ஆபத்தான காலம். எந்த ஒரு முக்கிய காரியத்தையும் தவிர்க்கவும்.</string>
    <string name="desc_thara_8">நட்பு தாரை: உதவிகளும் ஒத்துழைப்பும் கிடைக்கும் காலம். மற்றவர்களுடன் பழக ஏற்றது.</string>
    <string name="desc_thara_9">பரம நட்பு தாரை: அதீத பலமும் பாதுகாப்பும் தரும் காலம். மிக உயரிய பணிகளுக்கு ஏற்றது.</string>

    <string name="desc_yoga_amirtha">அமிர்த யோகம்: அமிர்தம் போன்ற இனிமையான காலம். அனைத்து சுப காரியங்களுக்கும் மிகச் சிறப்பு.</string>
    <string name="desc_yoga_siddha">சித்த யோகம்: சித்தி தரும் காலம். தொடங்கிய காரியங்களை வெற்றிகரமாக முடிக்க ஏற்றது.</string>
    <string name="desc_yoga_marana">மரண யோகம்: மரண யோக காலத்தில் சுப காரியங்களைத் தவிர்க்கவும். வழக்கமான பணிகளை மட்டும் செய்யவும்.</string>
    <string name="desc_yoga_vadha">வதை யோகம்: காரியங்கள் தோல்வியடைய வாய்ப்புள்ள காலம். இறை வழிபாடு மற்றும் தியானத்திற்கு ஏற்றது.</string>
